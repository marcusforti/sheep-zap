# Chaves do sheep-zap. Este arquivo fica só neste computador.
# Quem usa o painel da Sheep pode deixar em branco: as chaves de Conexões já valem.

# Endereço da sua Evolution, sem barra no fim. Ex.: http://SEU-IP:8080
EVOLUTION_URL=
# Chave da sua Evolution
EVOLUTION_API_KEY=

# Opcional. Sem ela, nada de áudio na voz do agente.
ELEVENLABS_API_KEY=

# Só se o número do dono estiver em outra Evolution
DONO_EVOLUTION_URL=
DONO_EVOLUTION_API_KEY=
